# Telegram Bot
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Провайдер нейросети: 'deepseek', 'ollama', 'runpod', 'openai', 'openrouter', 'groq'
LLM_PROVIDER=deepseek

# === Вариант 1: DeepSeek API (Основной) ===
API_KEY=sk_your_deepseek_api_key_here
API_BASE_URL=https://api.deepseek.com
API_MODEL=DeepSeek-V4-Pro

# === Вариант 2: Ollama (Запасной локальный вариант) ===
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Лимиты и параметры генерации
NUM_PREDICT=4096
MAX_CONTEXT_CHARS=6000
REQUEST_TIMEOUT=300


